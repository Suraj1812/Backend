{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frontend-foundation-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:3000",
    "JWT_ISSUER": "frontend-foundation-api-local",
    "JWT_AUDIENCE": "frontend-foundation-clients",
    "ACCESS_TOKEN_TTL_SECONDS": "900",
    "SESSION_TTL_SECONDS": "604800",
    "MAX_JSON_BYTES": "65536",
    "MAX_UPLOAD_BYTES": "5242880",
    "ALLOW_REGISTRATION": "true",
    "AUDIT_RETENTION_DAYS": "90"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "frontend-foundation-dev", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000001" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "frontend-foundation-dev-files" }],
  "ratelimits": [
    { "name": "API_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "env": {
    "production": {
      "name": "frontend-foundation-api",
      "workers_dev": false,
      "preview_urls": false,
      // Add routes: [{ pattern: "api.your-domain.com", custom_domain: true }].
      "limits": { "cpu_ms": 1000 },
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOWED_ORIGINS": "https://replace-me.example.com",
        "JWT_ISSUER": "frontend-foundation-api",
        "JWT_AUDIENCE": "frontend-foundation-clients",
        "ACCESS_TOKEN_TTL_SECONDS": "900",
        "SESSION_TTL_SECONDS": "604800",
        "MAX_JSON_BYTES": "65536",
        "MAX_UPLOAD_BYTES": "5242880",
        "ALLOW_REGISTRATION": "true",
        "AUDIT_RETENTION_DAYS": "90"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "frontend-foundation-prod", "database_id": "REPLACE_WITH_PRODUCTION_D1_ID", "migrations_dir": "migrations" }],
      "kv_namespaces": [{ "binding": "CACHE", "id": "REPLACE_WITH_PRODUCTION_KV_ID" }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "frontend-foundation-prod-files" }],
      "ratelimits": [
        { "name": "API_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } }
      ],
      "triggers": { "crons": ["0 3 * * *"] }
    }
  }
}
