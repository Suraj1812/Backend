# Server only. Copy to .env.local, then run npm run setup:local.
# Production settings come from docs/configuration.json plus Supabase Secrets.
JWT_SECRET=
PASSWORD_PEPPER=
IP_HASH_SECRET=
MAINTENANCE_SECRET=
# Required only in the deployed Edge runtime, supplied by Supabase:
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only
# SUPABASE_DB_URL=postgresql://server-only
